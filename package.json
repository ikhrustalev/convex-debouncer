{
  "name": "@ikhrustalev/convex-debouncer",
  "description": "A debouncer component for Convex.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikhrustalev/convex-debouncer.git"
  },
  "homepage": "https://github.com/ikhrustalev/convex-debouncer#readme",
  "bugs": {
    "url": "https://github.com/ikhrustalev/convex-debouncer/issues"
  },
  "version": "0.2.0",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component"
  ],
  "type": "module",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:backend": "convex dev --typecheck-components",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'pnpm run build:codegen' --initial",
    "predev": "path-exists .env.local dist || (pnpm run build && convex dev --once)",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && pnpm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "all": "run-p -r 'dev:*' 'test:watch'",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "preversion": "pnpm install --frozen-lockfile && pnpm run build:clean && run-p test lint typecheck",
    "alpha": "pnpm version prerelease --preid alpha && pnpm publish --tag alpha && git push --follow-tags",
    "release": "pnpm version patch && pnpm publish && git push --follow-tags",
    "version": "prettier -w CHANGELOG.md && git add CHANGELOG.md"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "convex": "^1.29.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "9.39.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "chokidar-cli": "3.0.0",
    "convex": "1.50.0",
    "convex-test": "0.0.71",
    "cpy-cli": "^6.0.0",
    "eslint": "9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.0.0",
    "npm-run-all2": "8.0.4",
    "path-exists-cli": "2.0.0",
    "pkg-pr-new": "^0.0.60",
    "prettier": "3.6.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vite": "7.2.6",
    "vitest": "4.0.17"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "packageManager": "pnpm@12.16.1"
}
